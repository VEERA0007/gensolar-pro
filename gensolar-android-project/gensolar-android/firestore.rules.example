// EXAMPLE ONLY: review and test with Firebase Emulator Suite before deployment.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return userDoc().role; }
    function org() { return userDoc().organizationId; }
    function isManager() { return signedIn() && (role() == 'manager' || role() == 'admin'); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid ||
        (isManager() && resource.data.organizationId == org()));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'customer';
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid ||
        (isManager() && resource.data.organizationId == org()) ||
        (role() == 'representative' && resource.data.assignedRepUid == request.auth.uid));
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (resource.data.ownerUid == request.auth.uid ||
        (role() == 'representative' && resource.data.assignedRepUid == request.auth.uid) ||
        (isManager() && resource.data.organizationId == org()));
      allow delete: if false;
    }

    match /leads/{leadId} {
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid ||
        resource.data.assignedRepUid == request.auth.uid ||
        (isManager() && resource.data.organizationId == org()));
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow update: if signedIn() && (
        (resource.data.customerUid == request.auth.uid &&
         request.resource.data.customerUid == resource.data.customerUid &&
         request.resource.data.assignedRepUid == resource.data.assignedRepUid &&
         request.resource.data.status == resource.data.status) ||
        (resource.data.assignedRepUid == request.auth.uid &&
         request.resource.data.assignedRepUid == resource.data.assignedRepUid &&
         request.resource.data.organizationId == resource.data.organizationId) ||
        (isManager() && resource.data.organizationId == org()));
      allow delete: if false;
    }

    match /calculations/{id} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    match /followups/{id} {
      allow read: if signedIn() && (resource.data.repUid == request.auth.uid ||
        (isManager() && resource.data.organizationId == org()));
      allow create: if signedIn() && resource.data.repUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
