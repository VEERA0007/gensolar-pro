rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myRole() {
      return hasProfile() ? me().role : '';
    }
    function myOrg() {
      return hasProfile() && me().organizationId is string ? me().organizationId : '';
    }

    function isManager() {
      return myRole() == 'manager' || myRole() == 'admin';
    }
    function isRep() {
      return myRole() == 'rep' || myRole() == 'representative';
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      // Managers and admins can list users so they can review role requests.
      allow read: if hasProfile() && isManager();
      // Managers approve or decline role requests. Only an admin can grant manager access;
      // the admin role itself is assigned only in the Firebase console.
      allow update: if hasProfile() && isManager()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['role', 'organizationId', 'requestedRole', 'approvedBy', 'approvedAt'])
        && request.resource.data.role in ['customer', 'rep', 'manager']
        && (request.resource.data.role != 'manager' || myRole() == 'admin' || resource.data.role == 'manager')
        && request.resource.data.get('organizationId', '') in ['', myOrg()];
      // New accounts can create only their own customer profile.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'customer';
      // Users may edit their own basic profile, never their role or organization.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('organizationId', '') == resource.data.get('organizationId', '')
        && request.resource.data.get('requestedRole', 'customer') in ['admin','sales_head','regional_manager','sales_manager','sales_rep','channel_partner','customer'];
      allow delete: if false;
    }

    match /leads/{leadId} {
      function sameOrg() {
        return hasProfile()
          && isManager()
          && resource.data.organizationId == myOrg();
      }
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || resource.data.assignedRepUid == request.auth.uid
        || sameOrg()
      );
      allow create: if hasProfile() && (
        (myRole() == 'customer'
          && request.resource.data.ownerUid == request.auth.uid)
        || (isRep()
          && request.resource.data.assignedRepUid == request.auth.uid
          && request.resource.data.organizationId == myOrg())
        || (isManager()
          && request.resource.data.organizationId == myOrg())
      );
      allow update: if hasProfile() && (
        (isManager()
          && resource.data.organizationId == myOrg()
          && request.resource.data.organizationId == resource.data.organizationId)
        || (isRep()
          && resource.data.assignedRepUid == request.auth.uid
          && request.resource.data.assignedRepUid == resource.data.assignedRepUid
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.ownerUid == resource.data.ownerUid)
        || (myRole() == 'customer'
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.assignedRepUid == resource.data.assignedRepUid
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.status == resource.data.status)
      );
      allow delete: if hasProfile() && (
        (isManager() && resource.data.organizationId == myOrg())
        || (isRep() && resource.data.assignedRepUid == request.auth.uid)
        || (myRole() == 'customer' && resource.data.ownerUid == request.auth.uid)
      );
    }

    // Other collections are denied until their data model and access rules are implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}